# LLM provider: anthropic | openai (only affects the startup missing-key warning)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Must match an id in config/deploy.yaml's llm.models catalog. Leave unset to use that
# file's llm.default_model (gpt-5.6-luna out of the box).
# LLM_MODEL=gpt-5.6-luna

# Data paths (local dev)
DATA_DIR=./data
DUCKDB_PATH=./data/navigator.duckdb

# Production (Render / Docker) — set in render.yaml or dashboard
# DATA_DIR=/data
# DUCKDB_PATH=/data/navigator.duckdb

# API
API_HOST=0.0.0.0
API_PORT=8000
# Render injects PORT automatically
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Production: CORS_ORIGINS=https://your-app.onrender.com

# Session
SESSION_TTL_MINUTES=30
MAX_CHAT_TURNS=5

MAX_TOOL_ROUNDS=8

# LLM reliability (production)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Optional pre-processing mediator: a second LLM call that normalizes phrasing and
# extracts dates before the main agent loop. Off by default.
# MEDIATOR_ENABLED=1
# MEDIATOR_LLM_MODEL=gpt-5.6-luna
# MEDIATOR_TIMEOUT_SECONDS=4.0
# MEDIATOR_MAX_RETRIES=1

# Offline tests / local dev without API keys — do not set on production Render
# LLM_MOCK=1

# Nightly ingest schedule, Render plan hints, and the LLM model catalog/defaults
# all live in config/deploy.yaml (UTC cron for supercronic)
# Active states: comma-separated; intersected with pdp_region_codes in ingest_filters.yaml
# INGEST_STATES=AR,TX,CA

# Render MCP (local Cursor only — do not set on the Render service)
RENDER_API_KEY=
